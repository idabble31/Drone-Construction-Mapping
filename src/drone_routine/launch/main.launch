<launch>
    <arg name="use_sim_time" default="false" />
    <arg name="tf_prefix" default="$(optenv ROS_NAMESPACE)"/>
    <arg name="use_ground_truth_for_tf" default="true"/>

    <arg name="enable_r3live" default="true" doc="Set to true to launch R3LIVE mapping"/>
    <arg name="lidar_type" default="5" doc="1:Livox, 5:Robosense/Sim_Merged"/> 

    <param name="use_sim_time" value="$(arg use_sim_time)" />


    <param name="robot_description"
           command="$(find xacro)/xacro '$(find drone_description)/urdf/construction_drone_hector.xacro'" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>

    <node pkg="rslidar_sdk" type="rslidar_sdk_node" name="rslidar_front" output="screen">
        <param name="config_path" value="$(find rslidar_sdk)/config/rslidar_front.yaml"/>
    </node>

    <include file="$(find inertial_sense)/launch/test.launch" />

    <!-- <group ns="rear_camera">
        <node pkg="drone_middleware" type="dewarp_fisheye_node" name="dewarp_fisheye_node" >
            <param name="device" value="/dev/video4"/>
            <param name="frame_id" value="fisheye_camera_rear_link"/>
            <param name="camera_name" value="rear_camera" />
            <param name="camera_info_url" value="file:///home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/rear_camera.yaml" />
            <param name="matrix_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/camera_matrix.npy"/>
            <param name="dist_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/dist_coeffs.npy" />
        </node>
    </group> -->

    <group ns="front_camera">
        <node pkg="drone_middleware" type="dewarp_fisheye_node" name="dewarp_fisheye_node" >
            <param name="device" value="/dev/video0"/>
            <param name="frame_id" value="fisheye_camera_front_link"/>
            <param name="camera_name" value="front_camera" />
            <param name="camera_info_url" value="file:///home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/front_camera.yaml" />
            <param name="matrix_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/camera_matrix.npy"/>
            <param name="dist_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/dist_coeffs.npy" />
        </node>
    </group>


    <node pkg="drone_middleware" type="sync_with_imu_interp" name="sync_with_imu_interp" output="screen"/>

    <node name="ground_truth_to_tf" pkg="drone_middleware" type="message_to_tf" output="screen">
        <param name="odometry_topic" value="ins"/>
        <param name="frame_id" value="aft_mapped"/>
        <param name="tf_prefix" value="$(arg tf_prefix)" if="$(arg use_ground_truth_for_tf)"/>
        <param name="tf_prefix" value="$(arg tf_prefix)/ground_truth" unless="$(arg use_ground_truth_for_tf)"/>
    </node>

    <node pkg="tf" type="static_transform_publisher" name="lidar_tf_bridge" 
      args="0 0 0 0 0 0 base_link lidar_front_link 10" />

    <group if="$(arg enable_r3live)">
        <param name="/LiDAR_pointcloud_topic" type="string" value="/laser_cloud_flat" />
        <param name="/IMU_topic"              type="string" value="/imu" />
        <param name="/Image_topic"            type="string" value="/front_camera/image_dewarped" />
        <param name="map_output_dir"          type="string" value="$(env HOME)/r3live_output" />

        <rosparam command="load" file="$(find r3live)/../config/r3live_config.yaml" />
        <rosparam command="load" file="$(find drone_routine)/config/r3live_lidar_front.yaml" />

        <param name="/Lidar_front_end/point_step"        type="int" value="6" />
        <param name="r3live_lio/lio_update_point_step"   type="int" value="6" />
        <param name="/Lidar_front_end/lidar_type"        type="int" value="$(arg lidar_type)"/>

        <node pkg="r3live" type="r3live_LiDAR_front_end" name="r3live_LiDAR_front_end" output="screen" required="true"/>
        <node pkg="r3live" type="r3live_mapping"        name="r3live_mapping"       output="screen" required="true"/>

        <node pkg="rviz" type="rviz" name="rviz" args="-d $(find drone_routine)/rviz/r3live_view.rviz" required="false"/>
    </group>

</launch>
