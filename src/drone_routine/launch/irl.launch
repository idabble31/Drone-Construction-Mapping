<launch>
    <arg name="enable_r3live" default="false" />
    <arg name="use_sim_time" default="false" />

    <param name="use_sim_time" value="$(arg use_sim_time)" />

    <!-- robot description -->
    <param name="robot_description"
           command="$(find xacro)/xacro '$(find drone_description)/urdf/construction_drone_hector.xacro'" />
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen"/>

    <!-- Front camera -->
    <group ns="rear_camera">
        <node pkg="drone_middleware" type="dewarp_fisheye_node" name="dewarp_fisheye_node" >
            <param name="device" value="/dev/video4"/>
            <param name="frame_id" value="fisheye_camera_rear_link"/>
            <param name="camera_name" value="rear_camera" />
            <param name="camera_info_url" value="file:///home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/rear_camera.yaml" />
            <param name="matrix_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/camera_matrix.npy"/>
            <param name="dist_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/dist_coeffs.npy" />
        </node>
    </group>

    <!-- Rear camera -->
    <group ns="front_camera">
        <node pkg="drone_middleware" type="dewarp_fisheye_node" name="dewarp_fisheye_node" >
            <param name="device" value="/dev/video0"/>
            <param name="frame_id" value="fisheye_camera_front_link"/>
            <param name="camera_name" value="front_camera" />
            <param name="camera_info_url" value="file:///home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/front_camera.yaml" />
            <param name="matrix_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/camera_matrix.npy"/>
            <param name="dist_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/dist_coeffs.npy" />
            <!-- <remap from="image_dewarped" to="/camera/image_color" />
            <remap from="image_color" to="/camera/camera_info" /> -->
        </node>
    </group>

    <!-- IMU and LiDAR nodes -->
    <node pkg="inertial_sense" type="inertial_sense_node" name="inertial_sense_node"/>
    <node pkg="rslidar_sdk" type="rslidar_sdk_node" name="rslidar_right" output="screen">
        <param name="config_path" value="$(find rslidar_sdk)/config/rslidar_right.yaml"/>
    </node>
    <node pkg="rslidar_sdk" type="rslidar_sdk_node" name="rslidar_left" output="screen">
        <param name="config_path" value="$(find rslidar_sdk)/config/rslidar_left.yaml"/>
    </node>

    <!-- Transforms - FIXED: Cameras now face forward/backward -->
    <!-- Front camera faces forward (+X direction) -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_front_camera" args="0.5 0 0 0 0 3.14159 base_link fisheye_camera_front_link" /> -->
    <!-- Rear camera faces backward (-X direction) -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_rear_camera" args="0.5 0 0 0 0 -3.14159 base_link fisheye_camera_rear_link" /> -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_ins" args="0 0 0 0 0 0 world ins" /> -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="world_to_ins" args="0 0 0 0 0 0 aft_mapped ins" /> -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_body" args="0 0 0 0 0 0 base_link body" /> -->
    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_right_to_rslidar_front" args="1.2 0.0 0.0 0 -1.5708 0 lidar_right_link rslidar_front"/>
    <node pkg="tf2_ros" type="static_transform_publisher" name="lidar_left_to_rslidar_rear" args="-1.2 -1.5 0.0 1.5708 0.0 -1.5708 lidar_left_link rslidar_rear" /> -->

    <!-- New TF Tree -->
    <!-- Connect aft_mapped to ins (IMU frame) -->
    <!-- Identity transform since R3LIVE's aft_mapped represents the IMU pose -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="aft_mapped_to_ins" 
          args="0 0 0 0 0 0 aft_mapped ins" />
    
    <!-- Connect ins to base_link (robot body center) -->
    <!-- Adjust x y z roll pitch yaw if your IMU is offset from robot center -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="ins_to_base_link" 
          args="0 0 0 0 0 0 ins base_link" />
    

    <!-- Merge two lidars -->
    <node pkg="drone_middleware" type="merge_two_lidars" name="merge_two_lidars" output="screen">
        <param name="topic1" value="/rslidar_left/points"/>
        <param name="topic2" value="/rslidar_right/points"/>
        <param name="output" value="/rslidar_merged/points" />
        <param name="target_frame" value="base_link" />
    </node>

    <node pkg="drone_middleware" type="sync_with_imu_interp" name="sync_with_imu_interp" output="screen"/>

    <!-- include r3live launch (controlled via enable_r3live arg) -->
    <!-- <include file="$(find drone_routine)/launch/r3live.launch"> -->
        <!-- <arg name="enabled" value="$(arg enable_r3live)"/> -->
    <!-- </include> -->

    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find drone_routine)/rviz/debug_view2.rviz" required="false"/> -->

</launch>
