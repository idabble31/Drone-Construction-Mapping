<launch>
  <!--  camera args you may tweak  -->
  <arg name="device"        default="/dev/video0"/>
  <arg name="width"         default="640"/>
  <arg name="height"        default="480"/>
  <arg name="fps"           default="30"/>
  <arg name="pixel_format"  default="yuyv"/>   <!-- common: mjpeg or yuyv -->
  <arg name="io_method"     default="mmap"/>    <!-- mmap / read / userptr -->
  <arg name="frame_id"      default="usb_cam"/>
  <arg name="cam_name"      default="usb_cam"/>

  <!--  usb_cam node  -->
  <node pkg="usb_cam" type="usb_cam_node" name="usb_cam" output="screen">
    <param name="video_device"     value="$(arg device)"/>
    <param name="image_width"      value="$(arg width)"/>
    <param name="image_height"     value="$(arg height)"/>
    <param name="framerate"        value="$(arg fps)"/>
    <param name="pixel_format"     value="$(arg pixel_format)"/>
    <param name="io_method"        value="$(arg io_method)"/>
    <param name="camera_frame_id"  value="$(arg frame_id)"/>
    <param name="camera_name"      value="$(arg cam_name)"/>
    <param name="camera_info_url" value=""/>
  </node>

  <!-- Optional: a trivial TF so RViz has a fixed frame -->
  <node pkg="tf" type="static_transform_publisher" name="usb_cam_tf"
        args="0 0 0 0 0 0 map $(arg frame_id) 10"/>
</launch>
