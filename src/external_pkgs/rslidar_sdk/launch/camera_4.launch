<launch>
  <!-- optional: where to save and how to name files -->
  <arg name="save_dir" default="$(env HOME)/dev/Drone-Construction-Mapping/images/front"/>
  <arg name="filename_format" default="$(arg save_dir)/capture_%04d.jpg"/>

  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="/dev/video0" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="color_format" value="yuv422p" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="io_method" value="mmap"/>
    <!-- optional: set a framerate -->
    <!-- <param name="framerate" value="30" /> -->
  </node>

  <!-- live viewer -->
  <node name="image_view" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/usb_cam/image_raw"/>
    <param name="autosize" value="true" />
  </node>

  <!-- on-demand saver: call its /image_saver/save service to take a snapshot -->
  <node name="image_saver" pkg="image_view" type="image_saver" output="screen">
    <remap from="image" to="/usb_cam/image_raw"/>
    <param name="save_all_image" value="false"/>                <!-- don't save every frame -->
    <param name="filename_format" value="$(arg filename_format)"/>
    <!-- optional: choose PNG by using *.png in filename_format -->
  </node>
</launch>
