<launch>
    <arg name="enable_r3live" default="false" />

    <group ns="front_camera">
        <node pkg="drone_middleware" type="dewarp_fisheye_node" name="dewarp_fisheye_node" >
            <param name="device" value="/dev/video4"/>
            <param name="frame_id" value="fisheye_camera_front_link"/>
            <param name="camera_name" value="front_camera" />
            <param name="camera_info_url" value="file:///home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/front_camera.yaml" />
            <param name="matrix_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/src/camera_matrix.npy"/>
            <param name="dist_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/src/dist_coeffs.npy" />
        </node>
    </group>
   
    <group ns="rear_camera">
        <node pkg="drone_middleware" type="dewarp_fisheye_node" name="dewarp_fisheye_node" >
            <param name="device" value="/dev/video0"/>
            <param name="frame_id" value="fisheye_camera_rear_link"/>
            <param name="camera_name" value="rear_camera" />
            <param name="camera_info_url" value="file:///home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/rear_camera.yaml" />
            <param name="matrix_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/src/camera_matrix.npy"/>
            <param name="dist_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/src/dist_coeffs.npy" />
            <remap from="image_dewarped" to="/camera/image_color" />
            <remap from="image_color" to="/camera/camera_info" />
        </node>
    </group>
    <node pkg="inertial_sense" type="inertial_sense_node" name="inertial_sense_node"/>
    <node pkg="rslidar_sdk" type="rslidar_sdk_node" name="rslidar_front" output="screen">
    <param name="config_path" value="$(find rslidar_sdk)/config/lidar_front.yaml"/>
  </node>
  <!-- Rear LiDAR -->
  <node pkg="rslidar_sdk" type="rslidar_sdk_node" name="rslidar_rear" output="screen">
    <param name="config_path" value="$(find rslidar_sdk)/config/lidar_rear.yaml"/>
  </node>
  <!-- Transforms -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_front" output="screen"
        args="1.2 0.0 0.5 0 -1.5708 0 base_link rslidar_front"/> <!-- rslidar_front -->
 
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_rear" output="screen"
        args="2.4 0.0 0.5 0 -1.5708 -3.14159 base_link rslidar_rear"/>
  <!-- <group ns="below_camera">
      <node pkg="drone_middleware" type="dewarp_fisheye_node" name="dewarp_fisheye_node" >*
          <param name="device" value="/dev/video2"/>*
          <param name="frame_id" value="below_camera"/>*
          <param name="camera_name" value="below_camera" />*
          <param name="camera_info_url" value="file:///home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/config/below_camera.yaml" />*
          <param name="matrix_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/src/camera_matrix.npy"/>*
          <param name="dist_path" value="/home/scanhub/dev/Drone-Construction-Mapping/src/drone_middleware/src/dist_coeffs.npy" />*
      </node>*
  </group> -->
    <!-- Static Transforms from all_cameras.launch -->
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_front_camera" args="0 0 0 0 0 0 base_link fisheye_camera_front_link" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_middle_camera" args="-0.5 0 0 0 0 0 base_link below_camera" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_rear_camera" args="-1 0 0 0 0 0 base_link fisheye_camera_rear_link" />
    <node pkg="tf2_ros" type="static_transform_publisher" name="base_link_to_body" args="0 0 0 0 0 0 base_link body" />

    <node pkg="drone_middleware" type="merge_two_lidars" name="merge_two_lidars" output="screen">
        <param name="topic1" value="/rslidar_front/points"/>
        <param name="topic2" value="/rslidar_rear/points"/>
        <param name="output" value="/lidar/merged_points" /> 
    </node>


    <group if="$(arg enable_r3live)">
        <param name="/LiDAR_pointcloud_topic" type="string" value="/laser_cloud_flat" />
        <param name="/IMU_topic"             type="string" value="/imu" />
        <param name="/Image_topic"           type="string" value="/camera/image_color" />
        <param name="map_output_dir" type="string" value="$(env HOME)/r3live_output" />
        <rosparam command="load" file="$(find r3live)/../config/r3live_config.yaml" />
        <param name="/Lidar_front_end/lidar_type" type="int" value="4" />
        <param name="/Lidar_front_end/point_step" type="int" value="1" />
        <param name="r3live_lio/lio_update_point_step" type="int" value="6" />
        <node pkg="r3live" type="r3live_LiDAR_front_end" name="r3live_LiDAR_front_end" output="screen" required="true"/>
        <node pkg="r3live" type="r3live_mapping"       name="r3live_mapping"       output="screen" required="true"/>
    </group>
</launch>