        Y: -0.3387157618999481
        Z: 0.09622002393007278
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.5747970938682556
      Target Frame: <Fixed Frame>
      Yaw: 5.613594055175781
    Saved: ~
