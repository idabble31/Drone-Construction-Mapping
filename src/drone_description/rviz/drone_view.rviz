      Style: Flat Squares
      Topic: /lidar_left/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/Camera
      Enabled: true
      Image Rendering: background and overlay
      Image Topic: /fisheye_camera_below/fisheye_camera_below/image_raw
      Name: Camera
      Overlay Alpha: 0.5
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
      Visibility:
        Camera: true
        Grid: true
        Odometry: true
        PointCloud2: true
        Pose: true
        RobotModel: true
        Value: false
      Zoom Factor: 1
    - Class: rviz/Camera
