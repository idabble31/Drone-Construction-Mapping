<?xml version="1.0"?>
<robot name="lidar1" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro for forward RoboSense Airy LiDAR -->
  <xacro:macro name="robosense_airy_lidar1" params="name parent xyz rpy">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://drone_description/meshes/airy_lidar.dae" scale="1 1 1"/> <!-- Placeholder mesh -->
        </geometry>
        <material name="silver">
          <color rgba="0.7 0.7 0.7 1"/> <!-- Fallback if DAE lacks textures -->
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://drone_description/meshes/airy_lidar.dae" scale="1 1 1"/> <!-- Same mesh -->
        </geometry>
      </collision>
      <inertial>
        <mass value="0.24"/> <!-- Airy: <240g -->
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/> <!-- Approximate -->
      </inertial>
    </link>
    <joint name="${name}_to_${parent}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/> <!-- Relative to base_link -->
    </joint>
  </xacro:macro>

  <!-- Instantiate forward LiDAR -->
  <!-- <xacro:robosense_airy_lidar1 name="lidar1" parent="base_link" xyz="0.2 0.0 0.5" rpy="0 0 0"/> -->
</robot>