<?xml version="1.0"?>
<robot name="fisheye_camera_gz" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Gazebo sensor + ROS plugin for the fisheye camera -->
  <xacro:macro name="fisheye_camera_gazebo" params="name topic info_topic hfov">
    <gazebo reference="${name}_link">
      <sensor type="wideanglecamera" name="${name}_fisheye_cam">
        <pose>0 -0.5 0 0 0 -1.5708</pose>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <distortion>
            <k1>-0.28</k1>
            <k2>0.074</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>
              <x>0.5</x>
              <y>0.5</y>
            </center>
          </distortion>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
          <lens>
            <type>stereographic</type> <!-- or gnomonic, equidistant, etc. -->
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.5708</cutoff_angle> 90 degrees
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name="${name}_camera_controller" filename="libgazebo_ros_camera.so">
          <cameraName>${name}</cameraName>
          <imageTopicName>${topic}</imageTopicName>
          <cameraInfoTopicName>${info_topic}</cameraInfoTopicName>
          <frameName>${name}_link</frameName>
          <updateRate>50.0</updateRate>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>