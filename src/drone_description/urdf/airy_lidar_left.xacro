<?xml version="1.0"?>
<robot name="lidar2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro for rear RoboSense Airy LiDAR -->
  <xacro:macro name="robosense_airy_lidar2" params="name parent xyz rpy">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://drone_description/meshes/airy_lidar.dae" scale="1 1 1"/> <!-- Placeholder mesh -->
        </geometry>
        <material name="silver">
          <color rgba="0.7 0.7 0.7 1"/> <!-- Fallback if DAE lacks textures -->
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://drone_description/meshes/airy_lidar.dae" scale="1 1 1"/> <!-- Same mesh -->
        </geometry>
      </collision>
      <inertial>
        <mass value="0.24"/> <!-- Airy: <240g -->
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/> <!-- Approximate -->
      </inertial>
    </link>
    <joint name="${name}_to_${parent}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/> <!-- Relative to base_link -->
    </joint>

     <!-- Gazebo Reference -->
    <gazebo reference="${name}_link">
      <sensor type="gpu_lidar" name="${name}_sensor">
        <pose>0 0 0 0 0 0</pose>
        <visualize>true</visualize>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>90</samples>
              <resolution>1</resolution>
              <min_angle>-1.57</min_angle> <!-- -90° -->
              <max_angle>1.57</max_angle> <!-- +90° -->
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>150</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <plugin name="${name}_controller" filename="libgazebo_ros_gpu_laser.so">
          <topicName>/${name}/points</topicName>
          <frameName>${name}_link</frameName>
        </plugin>
      </sensor>
    </gazebo>

  </xacro:macro>

  <!-- Instantiate rear LiDAR -->
  <!-- <xacro:robosense_airy_lidar2 name="lidar2" parent="base_link" xyz="-0.2 0.0 0.5" rpy="0 0 3.14159"/> -->
</robot>