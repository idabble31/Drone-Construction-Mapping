<?xml version="1.0"?>
<robot name="fisheye_camera" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Macro for wide-angle (fisheye) camera -->
  <xacro:macro name="fisheye_camera" params="name parent xyz rpy">
    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://drone_description/meshes/fisheye_camera.dae" scale="1 1 1"/>
        </geometry>
        <material name="black">
          <color rgba="0 0 0 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://drone_description/meshes/fisheye_camera.dae" scale="1 1 1"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${name}_to_${parent}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${name}_optical_frame"/>
    <joint name="${name}_optical_from_link" type="fixed">
      <parent link="${name}_link"/>
      <child  link="${name}_optical_frame"/>
      <!-- camera_link -> camera_optical (OpenCV) -->
      <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    </joint>


    <!-- Wide-angle (fisheye) Gazebo sensor -->
    <!-- <gazebo reference="${name}_link">
      <sensor type="wideanglecamera" name="${name}_fisheye_cam">
        <pose>0 -0.5 0 0 0 -1.5708</pose>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <distortion>
            <k1>-0.28</k1>
            <k2>0.074</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>
              <x>0.5</x>
              <y>0.5</y>
            </center>
          </distortion>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
          <lens>
            <type>stereographic</type> or gnomonic, equidistant, etc.
            <scale_to_hfov>true</scale_to_hfov>
            <cutoff_angle>1.5708</cutoff_angle> 90 degrees
            <env_texture_size>512</env_texture_size>
          </lens>
        </camera>
        <plugin name="${name}_camera_controller" filename="libgazebo_ros_camera.so">
          <cameraName>${name}</cameraName>
          <imageTopicName>/camera/image_color</imageTopicName>
          <cameraInfoTopicName>/camera/camera_info</cameraInfoTopicName>
          <frameName>${name}_link</frameName>
          <updateRate>50.0</updateRate>
        </plugin>
      </sensor>
    </gazebo> -->
  </xacro:macro>
</robot>
