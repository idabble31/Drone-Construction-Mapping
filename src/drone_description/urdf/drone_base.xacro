<?xml version="1.0"?>
<robot name="drone_base" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Dummy root link to satisfy KDL (no inertia) -->
  <!-- <link name="base_link"/> -->

  <!-- Base link (drone chassis) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://drone_description/meshes/drone_base_w_motors.stl" scale="1 1 1"/> <!-- DAE mesh, assuming mm units -->
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/> <!-- Fallback color if DAE lacks textures -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <!-- <mesh filename="package://drone_description/meshes/drone_base_w_motors.stl" scale="1 1 1"/>  -->
        <box size="0.3 0.3 0.2"/> 
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/> <!-- Placeholder: 1kg, adjust from CAD -->
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/> <!-- Placeholder, adjust from CAD -->
    </inertial>
  </link>

  <!-- Fixed joint connecting world_link to base_link -->
  <!-- <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint> -->
</robot>